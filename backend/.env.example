PORT=5000
NODE_ENV=development
SERVER_PATH=http://localhost:5000/
FRONT_END_PATH=http://localhost:3000/

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=1d
APP_JWT_EXPIRE=3650d

AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_S3_BUCKET_UPLOAD=idonneous
AWS_S3_BUCKET_STORE_IMAGES=idonneous/store_images
AWS_REGION=ap-south-1

LOCAL_URL=http://localhost:5000/api/v1/web/reset_password/
IMAGE_PATH=http://localhost:5000/media/upload
S3_IMAGE_PATHS=https://your-bucket.s3.ap-south-1.amazonaws.com/upload
S3_IMAGE_PATHS_MULTIPLE=https://your-bucket.s3.ap-south-1.amazonaws.com/multipleImageTesting

DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DIALECT=mysql

CLIENT_SERVER_URL=https://your-bucket.s3.ap-south-1.amazonaws.com/upload
